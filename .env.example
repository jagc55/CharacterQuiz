# ==========================================
# CONFIGURACIÓN DE APIS PARA PUBLICACIÓN
# ==========================================

# Horas entre cada publicación automática (por defecto: 4)
SCHEDULE_INTERVAL_HOURS=4

# --- YOUTUBE SHORTS (Google Cloud Data API v3) ---
# Ruta al archivo de credenciales descargado de Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
# Privacidad del video subido: "public", "unlisted" o "private"
YOUTUBE_PRIVACY_STATUS=public

# --- TIKTOK (TikTok Developers Content Posting API) ---
# Token de acceso de usuario con alcance 'video.upload'
TIKTOK_ACCESS_TOKEN=tu_access_token_de_tiktok_aqui
# Privacidad: "PUBLIC_TO_EVERYONE", "MUTUAL_FOLLOW_FRIENDS", "SELF_ONLY"
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
